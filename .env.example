# Database — SQLite (no installation needed, file created automatically)
DATABASE_URL=sqlite:///./medaudit.db

# API Keys — only CLAUDE_API_KEY is required
CLAUDE_API_KEY=sk-ant-YOUR_KEY_HERE
OPENAI_API_KEY=   # optional

# JWT
SECRET_KEY=change-me-in-production
JWT_EXPIRATION_HOURS=24

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# File uploads
STORAGE_PATH=/tmp/medaudit/uploads
